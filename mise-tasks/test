#!/usr/bin/env bash
#MISE description="Link this directory as the pub plugin and install protoc_plugin end to end"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

tool=protoc_plugin
version=25.1.0
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# mise prints Windows paths; bash globs and rm need the POSIX form under Git Bash.
posix_path() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -u "$1"
    else
        echo "$1"
    fi
}

# protoc-gen-dart answers an empty request with a fixed CodeGeneratorResponse on stdout.
# Every run must produce exactly those bytes, also while the wrapper rebuilds its snapshot.
run_tool() {
    mise exec "pub:$tool@$version" -- protoc-gen-dart </dev/null >"$1"
}

same_output() {
    cmp -s "$scratch/base.bin" "$1" || fail "$2: stdout differs from a normal run"
}

mise plugin link --force pub "$PWD"

versions=$(mise ls-remote "pub:$tool")
grep -qx 22.3.0 <<<"$versions" || fail "ls-remote did not list 22.3.0"
if grep -qx 21.0.1 <<<"$versions"; then
    fail "ls-remote listed the retracted version 21.0.1"
fi

if mise ls-remote pub:this_package_does_not_exist_xyz >/dev/null 2>&1; then
    fail "ls-remote succeeded for an unknown package"
fi

mise install --force "pub:$tool@$version"
run_tool "$scratch/base.bin" || fail "protoc-gen-dart did not run"
[ -s "$scratch/base.bin" ] || fail "protoc-gen-dart wrote nothing to stdout"

install_dir=$(posix_path "$(mise where "pub:$tool@$version")")
wrapper="$install_dir/bin/protoc-gen-dart"
if [ -f "$wrapper.bat" ]; then
    wrapper="$wrapper.bat"
fi
snapshot="$install_dir/snapshots/protoc_plugin.dill"
grep -q 'snapshots' "$wrapper" || fail "wrapper does not use the plugin's snapshot: $wrapper"
test -f "$snapshot" || fail "install did not compile the snapshot $snapshot"

# Recovery 1: the snapshot is missing.
rm "$snapshot"
run_tool "$scratch/missing.bin" || fail "recovery from a missing snapshot failed"
same_output "$scratch/missing.bin" "recovery from a missing snapshot"
test -f "$snapshot" || fail "the snapshot was not rebuilt"

# Recovery 2: the snapshot is stale. A kernel file with a foreign format version makes the
# VM exit with 253, and a changed SDK stamp makes the Windows wrapper recompile.
printf '\0\0\0\1' | dd of="$snapshot" bs=1 seek=4 conv=notrunc 2>/dev/null
if [ -f "$snapshot.sdk" ]; then
    echo stale >"$snapshot.sdk"
fi
run_tool "$scratch/stale.bin" || fail "recovery from a stale snapshot failed"
same_output "$scratch/stale.bin" "recovery from a stale snapshot"
run_tool "$scratch/after.bin" || fail "run after recovery failed"
same_output "$scratch/after.bin" "run after recovery"

if [ "$wrapper" != "${wrapper%.bat}" ]; then
    # A batch file shares the environment of the cmd session that runs it. The wrapper
    # must leave the caller's variables as they were.
    driver="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/pub-cache-leak.bat"
    printf '@echo off\r\nset "PUB_CACHE=caller"\r\ncall protoc-gen-dart.bat <nul >nul || exit /b 1\r\necho %%PUB_CACHE%%\r\n' \
        >"$(posix_path "$driver")"
    after=$(cd "$install_dir/bin" && cmd //c "$(cygpath -w "$driver")") || fail "wrapper failed inside the leak check"
    after=${after%$'\r'}
    [ "$after" = "caller" ] || fail "wrapper changed PUB_CACHE of the calling cmd session to: $after"
    rm -f "$(posix_path "$driver")"
fi

# Wrappers must survive paths with shell and cmd metacharacters, including quotes, which
# break pub's own launchers, and non-ASCII characters, which cmd reads in a legacy code
# page. Windows file names cannot contain double quotes. Only the installs directory gets
# the non-ASCII name: on Windows, mise itself cannot load a Lua plugin from a directory
# with non-ASCII characters.
hostile_name="mise data %USERNAME% !x! \$y 100% it's"
case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) ;;
*) hostile_name="$hostile_name \"dq\"" ;;
esac
hostile_data_dir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/$hostile_name"
hostile_installs_dir="$hostile_data_dir/installs Jörg"
hostile_posix=$(posix_path "$hostile_data_dir")
rm -rf "$hostile_posix"
mkdir -p "$hostile_posix"
# A separate config directory keeps the user's global tools out of dependency resolution,
# which would otherwise fail in the fresh data directory where none of them is installed.
# The real dart goes first on PATH because a mise shim cannot resolve in that directory.
dart_bin=$(dirname "$(posix_path "$(mise which dart 2>/dev/null || command -v dart)")")
hostile_mise() {
    PATH="$dart_bin:$PATH" MISE_DATA_DIR="$hostile_data_dir" MISE_CONFIG_DIR="$hostile_data_dir" \
        MISE_INSTALLS_DIR="$hostile_installs_dir" mise "$@"
}
hostile_mise plugin link --force pub "$PWD"
hostile_mise install --force "pub:$tool@$version"
hostile_install=$(posix_path "$(hostile_mise where "pub:$tool@$version")")
if [ -f "$hostile_install/bin/protoc-gen-dart.bat" ]; then
    # cmd expands %VAR% on its own command line too, so start it inside the directory.
    (cd "$hostile_install/bin" && cmd //c protoc-gen-dart.bat </dev/null >"$scratch/hostile.bin") ||
        fail "bat wrapper failed in a path with metacharacters"
    same_output "$scratch/hostile.bin" "bat wrapper in a path with metacharacters"
    (cd "$hostile_install/bin" && cmd //v:on //c protoc-gen-dart.bat </dev/null >"$scratch/hostile-v.bin") ||
        fail "bat wrapper failed with delayed expansion enabled"
    same_output "$scratch/hostile-v.bin" "bat wrapper with delayed expansion enabled"
else
    "$hostile_install/bin/protoc-gen-dart" </dev/null >"$scratch/hostile.bin" ||
        fail "sh wrapper failed in a path with metacharacters"
    same_output "$scratch/hostile.bin" "sh wrapper in a path with metacharacters"
fi
rm -rf "$hostile_posix"

echo "ok"
