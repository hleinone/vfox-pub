#!/usr/bin/env bash
#MISE description="Link this directory as the pub plugin and install protoc_plugin end to end"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

tool=protoc_plugin
version=25.1.0

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# mise prints Windows paths; bash globs and rm need the POSIX form under Git Bash.
posix_path() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -u "$1"
    else
        echo "$1"
    fi
}

pinned() {
    grep -Eq '^export PUB_CACHE=|set "PUB_CACHE=' "$1"
}

mise plugin link --force pub "$PWD"

versions=$(mise ls-remote "pub:$tool")
grep -qx 22.3.0 <<<"$versions" || fail "ls-remote did not list 22.3.0"
if grep -qx 21.0.1 <<<"$versions"; then
    fail "ls-remote listed the retracted version 21.0.1"
fi

if mise ls-remote pub:this_package_does_not_exist_xyz >/dev/null 2>&1; then
    fail "ls-remote succeeded for an unknown package"
fi

mise install --force "pub:$tool@$version"
mise exec "pub:$tool@$version" -- protoc-gen-dart </dev/null >/dev/null || fail "protoc-gen-dart did not run"

install_dir=$(posix_path "$(mise where "pub:$tool@$version")")
wrapper="$install_dir/bin/protoc-gen-dart"
if [ -f "$wrapper.bat" ]; then
    wrapper="$wrapper.bat"
fi
pinned "$wrapper" || fail "wrapper does not pin PUB_CACHE: $wrapper"

# A missing or stale snapshot sends pub's launcher down the `dart pub global run` path.
# pub then rebuilds the snapshot and rewrites its launcher. The PUB_CACHE setting must
# survive that, so the recovery has to work twice in a row.
snapshot=$(echo "$install_dir"/pub-cache/global_packages/$tool/bin/protoc_plugin.dart-*.snapshot)
for attempt in 1 2; do
    rm "$snapshot"
    mise exec "pub:$tool@$version" -- protoc-gen-dart </dev/null >/dev/null || fail "recovery $attempt: protoc-gen-dart did not run"
    test -f "$snapshot" || fail "recovery $attempt: snapshot was not rebuilt in $install_dir"
done
pinned "$wrapper" || fail "wrapper lost its PUB_CACHE setting after recovery"

# Wrappers must survive paths with shell and cmd metacharacters, including quotes, which
# break pub's own launchers. Windows file names cannot contain double quotes.
hostile_name="mise data %USERNAME% !x! \$y 100% it's"
case "$(uname -s)" in
MINGW* | MSYS* | CYGWIN*) ;;
*) hostile_name="$hostile_name \"dq\"" ;;
esac
hostile_data_dir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/$hostile_name"
hostile_posix=$(posix_path "$hostile_data_dir")
rm -rf "$hostile_posix"
mkdir -p "$hostile_posix"
# A separate config directory keeps the user's global tools out of dependency resolution,
# which would otherwise fail in the fresh data directory where none of them is installed.
# The real dart goes first on PATH because a mise shim cannot resolve in that directory.
dart_bin=$(dirname "$(posix_path "$(mise which dart 2>/dev/null || command -v dart)")")
hostile_mise() {
    PATH="$dart_bin:$PATH" MISE_DATA_DIR="$hostile_data_dir" MISE_CONFIG_DIR="$hostile_data_dir" mise "$@"
}
hostile_mise plugin link --force pub "$PWD"
hostile_mise install --force "pub:$tool@$version"
hostile_install=$(posix_path "$(hostile_mise where "pub:$tool@$version")")
if [ -f "$hostile_install/bin/protoc-gen-dart.bat" ]; then
    # cmd expands %VAR% on its own command line too, so start it inside the directory.
    (cd "$hostile_install/bin" && cmd //c protoc-gen-dart.bat </dev/null >/dev/null) ||
        fail "bat wrapper failed in a path with metacharacters"
    (cd "$hostile_install/bin" && cmd //v:on //c protoc-gen-dart.bat </dev/null >/dev/null) ||
        fail "bat wrapper failed with delayed expansion enabled"
else
    "$hostile_install/bin/protoc-gen-dart" </dev/null >/dev/null ||
        fail "sh wrapper failed in a path with metacharacters"
fi
rm -rf "$hostile_posix"

echo "ok"
